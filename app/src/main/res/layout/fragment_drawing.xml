
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- HEADER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="SCIENCE LAB"
        android:textColor="#4355C7"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="Drawing &amp; Charts"
        android:textColor="#19243C"
        android:textSize="23sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Canvas  •  Animation  •  Clock"
        android:textColor="#64748B"
        android:textSize="12sp"/>

    <!-- MAIN CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:elevation="2dp">

        <!-- TABS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDrawingMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="DRAWING"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4355C7"/>

            <Button
                android:id="@+id/btnChartMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="CHART"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#64748B"/>

            <Button
                android:id="@+id/btnClockMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="CLOCK"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#64748B"/>

        </LinearLayout>

        <!-- CANVAS AREA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="#F9FAFC"
            android:clipChildren="true"
            android:clipToPadding="true">

            <com.example.myapplication.feature_drawing_charts.DrawingCanvasView
                android:id="@+id/drawingCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"/>

            <com.example.myapplication.feature_drawing_charts.DynamicChartView
                android:id="@+id/dynamicChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:visibility="gone"/>

            <com.example.myapplication.feature_drawing_charts.AnalogClockView
                android:id="@+id/analogClock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- DRAWING CONTROLS -->
        <LinearLayout
            android:id="@+id/drawingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PEN / ERASER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="PEN"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4355C7"/>

                <Button
                    android:id="@+id/btnEraser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="ERASER"
                    android:textColor="#4355C7"
                    android:backgroundTint="#E1E7FA"/>

            </LinearLayout>

            <!-- BRUSH COLORS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:text="Brush Color"
                android:textColor="#19243C"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnBlack"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="●"
                    android:textSize="24sp"
                    android:textColor="#111827"
                    android:backgroundTint="#EDF0FA"
                    android:contentDescription="Black brush"/>

                <Button
                    android:id="@+id/btnRed"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="●"
                    android:textSize="24sp"
                    android:textColor="#EF4444"
                    android:backgroundTint="#EDF0FA"
                    android:contentDescription="Red brush"/>

                <Button
                    android:id="@+id/btnBlue"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="●"
                    android:textSize="24sp"
                    android:textColor="#3B82F6"
                    android:backgroundTint="#EDF0FA"
                    android:contentDescription="Blue brush"/>

                <Button
                    android:id="@+id/btnGreen"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="●"
                    android:textSize="24sp"
                    android:textColor="#22C55E"
                    android:backgroundTint="#EDF0FA"
                    android:contentDescription="Green brush"/>

                <Button
                    android:id="@+id/btnYellow"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="●"
                    android:textSize="24sp"
                    android:textColor="#EAB308"
                    android:backgroundTint="#EDF0FA"
                    android:contentDescription="Yellow brush"/>

            </LinearLayout>

            <!-- BRUSH SIZE -->
            <TextView
                android:id="@+id/txtBrushSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Brush Size: 12"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekBrushSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="12"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- UNDO / CLEAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUndo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="UNDO"
                    android:textColor="#4355C7"
                    android:backgroundTint="#E1E7FA"/>

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="CLEAR"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E46B63"/>

            </LinearLayout>

        </LinearLayout>

        <!-- CHART CONTROLS -->
        <LinearLayout
            android:id="@+id/chartControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnStartChart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="START"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4355C7"/>

            <Button
                android:id="@+id/btnPauseChart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="PAUSE"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#64748B"/>

            <Button
                android:id="@+id/btnResetChart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="RESET"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F9E91"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
