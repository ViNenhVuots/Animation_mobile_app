<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_science_lab"
            android:textColor="#4355C7"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/subtitle_physics"
            android:textColor="#19243C"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/tag_physics_features"
            android:textColor="#64748B"
            android:textSize="13sp"/>

        <!-- PHYSICS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/physics_playground_title"
                android:textColor="#19243C"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/physics_playground_desc"
                android:textColor="#64748B"
                android:textSize="12sp"/>

            <!-- KHU VUC MO PHONG -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="#EAF3FF"
                android:clipChildren="true"
                android:clipToPadding="true">

                <com.example.myapplication.feature_physics.SpringGravityView
                    android:id="@+id/springGravityView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#EAF3FF"/>

            </FrameLayout>

            <!-- GRAVITY -->
            <TextView
                android:id="@+id/txtGravity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lbl_gravity_default"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekGravity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="2000"
                android:progress="1200"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- SPRING -->
            <TextView
                android:id="@+id/txtSpring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lbl_spring_default"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekSpring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- BOUNCE -->
            <TextView
                android:id="@+id/txtBounce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lbl_bounce_default"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekBounce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="70"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- BALL MASS / WEIGHT -->
            <TextView
                android:id="@+id/txtMass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lbl_mass_default"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekMass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="45"
                android:progress="5"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- RESET PHYSICS -->
            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_reset_ball"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4355C7"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
