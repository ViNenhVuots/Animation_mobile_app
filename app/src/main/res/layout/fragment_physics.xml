
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SCIENCE LAB"
            android:textColor="#4355C7"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Physics Animation"
            android:textColor="#19243C"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Gravity  •  Spring  •  Collision"
            android:textColor="#64748B"
            android:textSize="13sp"/>

        <!-- PHYSICS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Physics Playground"
                android:textColor="#19243C"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Chạm, kéo và thả bóng để thử nghiệm"
                android:textColor="#64748B"
                android:textSize="12sp"/>

            <!-- KHU VUC MO PHONG -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="#EAF3FF"
                android:clipChildren="true"
                android:clipToPadding="true">

                <com.example.myapplication.feature_physics.SpringGravityView
                    android:id="@+id/springGravityView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#EAF3FF"/>

            </FrameLayout>

            <!-- GRAVITY -->
            <TextView
                android:id="@+id/txtGravity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Gravity: 1200"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekGravity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="2000"
                android:progress="1200"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- SPRING -->
            <TextView
                android:id="@+id/txtSpring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Spring Strength: 50"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekSpring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- BOUNCE -->
            <TextView
                android:id="@+id/txtBounce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Bounce: 70%"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/seekBounce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="70"
                android:progressTint="#4355C7"
                android:thumbTint="#4355C7"/>

            <!-- RESET PHYSICS -->
            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RESET BALL"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4355C7"/>

        </LinearLayout>

        <!-- PROPERTY ANIMATION CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Property Animation"
                android:textColor="#19243C"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="ObjectAnimator + AnimatorSet"
                android:textColor="#64748B"
                android:textSize="12sp"/>

            <!-- DOI TUONG ANIMATION -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#E8F5F3"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/animationTarget"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="#0F9E91"
                    android:textSize="40sp"/>

            </FrameLayout>

            <!-- PROPERTY BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStartProperty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="START"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4355C7"/>

                <Button
                    android:id="@+id/btnStopProperty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#64748B"/>

                <Button
                    android:id="@+id/btnResetProperty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RESET"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0F9E91"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
