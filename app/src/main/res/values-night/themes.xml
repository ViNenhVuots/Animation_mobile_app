<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Keep consistent Modern Science Lab Light theme across Day/Night so custom hardcoded light layouts never clash -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lab_primary</item>
        <item name="colorPrimaryContainer">@color/lab_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/lab_primary</item>
        <item name="colorSecondary">@color/lab_teal</item>
        <item name="colorSecondaryContainer">@color/lab_teal_light</item>
        <item name="android:windowBackground">@color/lab_bg</item>
        <item name="android:statusBarColor">@color/lab_bg</item>
        <item name="android:navigationBarColor">@color/lab_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
